# Copy to .env.postgres; replace both password placeholders with the same local secret.
POSTGRES_USER=case_review
POSTGRES_DB=case_review
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# For SQLite, override DATABASE_URL with sqlite:///./case_review.db (see README).
DATABASE_URL=postgresql+psycopg://case_review:<password>@127.0.0.1:5432/case_review
TEST_DATABASE_URL=postgresql+psycopg://case_review:<password>@127.0.0.1:5432/case_review_test
DEMO_REVIEWER_EMAIL=jordan.lee@example.com
# Optional provider settings: put these in backend/.env, not both env files.
# Commented here so copying this template to .env.postgres does not override
# an existing .env credential with an empty environment variable.
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen3-32B
# HF_PROVIDER=nscale

# Local reference retrieval; changing the pinned model/dimensions requires code + re-ingestion.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSIONS=384
REFERENCE_EXAMPLES=3

# Optional hosted tracing: synthetic case inputs and drafts are sent to LangSmith.
# Keep these in backend/.env when using the existing split environment setup.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=case-review-platform
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=  # Only needed for keys scoped to multiple workspaces.
